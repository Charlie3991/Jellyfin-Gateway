# Jellyfin Gateway configuration (read by gateway.py; also used by systemd)
# Template only. Never put real passwords, API keys, or tokens in this file.

# --- gateway web server ---
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8390
# hide the administrator Settings panel from the dashboard once setup is done
# (0 = visible, 1 = hidden; restore by setting 0 and restarting the gateway)
HIDE_SETTINGS=0
# (optional) trusted reverse proxies for the login rate limiter. Startup-only:
# a comma-separated list of IPs or CIDRs. When the gateway's socket peer is one
# of these, the real client used for per-IP login limits is read from
# X-Forwarded-For; otherwise that header is ignored entirely. Leave unset when
# the dashboard is not behind a reverse proxy.
#GATEWAY_TRUSTED_PROXIES=127.0.0.1,10.0.0.0/8

# --- qBittorrent WebUI ---
QB_URL=http://127.0.0.1:8090
QB_USER=admin
QB_PASS=YOUR_QB_WEBUI_PASSWORD

# --- Jellyfin (point at YOUR Jellyfin: local, LAN IP, or Tailscale IP) ---
# Required for Gateway user login and periodic user/admin validation.
# The separate API key is optional and is used only for the library item count
# and machine-to-machine refresh after sorts; it is never used as a user token.
JELLYFIN_URL=http://<jellyfin-host>:8096
JELLYFIN_API_KEY=

# --- media layout ---
# default (when unset): <project-dir>/media with Movies/TV/downloads inside.
# Uncomment to put the media tree somewhere else (e.g. a bigger drive):
#MEDIA_ROOT=/path/to/your/media
# optional: put movies / TV / downloads somewhere else (e.g. other drives);
# these override the folders derived from MEDIA_ROOT
#MOVIES_DIR=/mnt/movies
#TV_DIR=/mnt/tv
#DOWNLOAD_DIR=/home/<you>/Downloads

# --- sorting behaviour ---
# remove the torrent from qBittorrent after its files have been moved
SORT_DELETE_TORRENT=1
# ask Jellyfin to refresh its library after a successful sort (needs API key)
NOTIFY_JELLYFIN=1

# --- VPN guard (pause all torrents when the tunnel disappears) ---
VPN_GUARD=1
VPN_GUARD_POLL=5
# interface globs counted as "the VPN tunnel". A too-broad glob (e.g. '*')
# that matches a non-VPN interface (lo, eth0, wlan0, ...) is rejected: the
# gateway refuses to start and the Settings API returns 400, because such a
# pattern would let the guard treat a regular always-up interface as the VPN
# and silently defeat the kill switch.
VPN_GUARD_IFACES=tun*,tap*,nordlynx*
# (optional) path to the nordvpn CLI. Startup-only: resolved at boot and
# deliberately not editable from the dashboard Settings panel.
#NORDVPN_BIN=/usr/bin/nordvpn
