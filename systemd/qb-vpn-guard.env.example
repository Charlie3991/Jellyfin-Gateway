# qBittorrent VPN guard environment (install as ~/.config/qb-vpn-guard.env,
# chmod 0600). See vpn_guard.py for defaults.
# Template only. Never put real passwords, API keys, or tokens in this file.
QB_URL=http://127.0.0.1:8090
QB_USER=admin
QB_PASS=YOUR_QB_WEBUI_PASSWORD
# comma-separated fnmatch globs for the tunnel interface
TUNNEL_IFACES=nordlynx*,tun*,tap*
GUARD_POLL=5
